FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends iptables util-linux && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY requirements-fetcher.txt ./requirements-fetcher.txt
RUN pip install --no-cache-dir -r requirements-fetcher.txt
COPY fetcher ./fetcher
COPY fetcher/entrypoint.sh ./entrypoint.sh
RUN chmod 755 ./entrypoint.sh && useradd -r -u 10001 fetcher
EXPOSE 8001
ENTRYPOINT ["./entrypoint.sh"]
